{
  "permissions": {
    "allow": [
      "Bash(uv run scripts/ats.py:*)",
      "Bash(uv run scripts/filter.py:*)",
      "Bash(uv run scripts/score.py:*)",
      "Bash(uv run scripts/tracker.py pull:*)",
      "Bash(uv run scripts/tracker.py plan:*)",
      "Bash(uv run scripts/tracker.py check:*)",
      "Bash(uv run scripts/tracker.py exclude:*)",
      "Bash(uv run scripts/tracker.py change:*)",
      "WebSearch",
      "WebFetch",
      "Bash(uv run scripts/tracker.py verify-write:*)",
      "Bash(uv run scripts/tracker.py local-copy:*)",
      "mcp__claude_ai_Google_Sheets__get_values",
      "mcp__claude_ai_Google_Sheets__get_spreadsheet",
      "mcp__claude_ai_Google_Sheets__update_values",
      "mcp__claude_ai_Google_Sheets__batch_clear_values",
      "mcp__claude_ai_Google_Sheets__update_spreadsheet"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/welcome.sh\""
          }
        ]
      }
    ]
  }
}
